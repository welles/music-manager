@inherits LayoutComponentBase
@implements IDisposable
@inject PipelineNotifier Notifier
@inject PlayerService Player

<MudThemeProvider @bind-IsDarkMode="_dark" ObserveSystemDarkModeChange="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawer = !_drawer" />
        <MudLink Href="" Color="Color.Inherit" Underline="Underline.None" Class="d-flex align-center flex-shrink-0">
            <img src="icons/icon.svg" alt="" width="28" height="28" class="mr-2" />
            <MudText Typo="Typo.h6" Style="white-space:nowrap">Music Manager</MudText>
        </MudLink>
        <MudSpacer />
        @if (Notifier.CurrentActivity is { } activity)
        {
            @* min-width:0 lets the text shrink and end with an ellipsis instead of wrapping the title. *@
            <div class="d-flex align-center mx-4" style="min-width:0;max-width:60%">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" Class="mr-2 flex-shrink-0" />
                <MudText Typo="Typo.body2" Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="@activity">@activity</MudText>
            </div>
        }
        <MudToggleIconButton @bind-Toggled="_dark" Icon="@Icons.Material.Filled.DarkMode" ToggledIcon="@Icons.Material.Filled.LightMode" Color="Color.Inherit" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawer" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="py-4">
            @Body
            @if (Player.Current != null)
            {
                <div style="height:96px"></div>
            }
        </MudContainer>
        @if (Player.Current is { } track)
        {
            @* Player bar for listening to library files. *@
            <MudPaper Elevation="8" Class="pa-2 d-flex align-center" Style="position:fixed;bottom:0;left:0;right:0;z-index:1200;gap:12px">
                <MudImage Src="@($"api/library/{track.Id}/cover")" Width="56" Height="56" ObjectFit="ObjectFit.Cover" Class="rounded flex-shrink-0" />
                <div style="min-width:0;max-width:30%">
                    <MudText Typo="Typo.subtitle2" Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@track.Title</MudText>
                    <MudText Typo="Typo.caption" Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@string.Join(", ", track.ArtistNames) · @track.Album</MudText>
                </div>
                <audio controls autoplay src="@($"api/audio/library/{track.Id}")" style="flex:1;min-width:0"></audio>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Player.Stop" aria-label="Player schließen" />
            </MudPaper>
        }
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
</div>

@code {
    private bool _drawer = true;
    private bool _dark;

    private bool _subscribed;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !_subscribed)
        {
            Notifier.Changed += OnChanged;
            Player.Changed += OnChanged;
            _subscribed = true;
        }
    }

    private async void OnChanged()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Circuit already gone.
        }
    }

    public void Dispose()
    {
        if (_subscribed) Notifier.Changed -= OnChanged;
        Player.Changed -= OnChanged;
    }
}
