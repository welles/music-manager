<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

@* Blazor finds this element by its id and reports the connection state to it. Instead of the template's modal
   dialog it is a small notice at the bottom: reconnecting and resuming happen on their own (see the .js), and it
   only shows up when that takes longer than a moment. Styles are in app.css. *@
<div id="components-reconnect-modal" class="reconnect-notice" role="status" aria-live="polite" data-nosnippet>
    <span class="reconnect-spinner" aria-hidden="true"></span>
    <span id="reconnect-text">Verbindung wird wiederhergestellt …</span>
    <button id="reconnect-button" type="button" hidden>Neu laden</button>
</div>
