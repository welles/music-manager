@page "/playlists/spotify/{Id:int}"
@inherits LivePage
@using MusicManager.Core.Services
@using MusicManager.Core.Catalog
@inject IDbContextFactory<AppDbContext> DbFactory
@inject MediaCatalog Catalog
@inject LibraryCatalog Library
@inject SpotifyPlaylistSync Sync
@inject PlayerService Player
@inject IDialogService Dialogs
@inject NavigationManager Nav
@inject MusicFabRequests MusicFab
@inject ISnackbar Snackbar

<PageTitle>@(_playlist?.Name ?? "Spotify-Playlist") – Music Manager</PageTitle>

<PageHeader Title="@(_playlist?.Name ?? "Spotify-Playlist")" UseHistory="true" />

@if (_playlist == null)
{
    @if (_missing)
    {
        <MudAlert Severity="Severity.Info">Diese Playlist gibt es nicht (mehr).</MudAlert>
    }
    else
    {
        <MudProgressLinear Indeterminate="true" />
    }

    return;
}

<MudPaper Outlined="true" Class="pa-3 mb-4">
    <div class="d-flex flex-wrap" style="gap:16px">
        <CoverImage Src="@($"api/playlists/spotify/{_playlist.Id}/cover?v={_playlist.SyncedAt?.UtcTicks}")" Alt="@_playlist.Name" Original="true" Eager="true" Class="rounded" Style="width:160px" />
        <div style="min-width:0;flex:1 1 220px">
            <MudText Typo="Typo.h5">@_playlist.Name</MudText>
            <MudText Typo="Typo.body2">Spotify-Playlist@(_playlist.OwnerName is { Length: > 0 } o ? $" von {o}" : "")</MudText>
            @if (!string.IsNullOrWhiteSpace(_playlist.Description))
            {
                <MudText Typo="Typo.body2" Style="opacity:.75" Class="mt-1">@_playlist.Description</MudText>
            }
            <MudText Typo="Typo.body2" Class="mt-2"><b>@Matched</b> von @_rows.Count Titeln in deiner Bibliothek</MudText>
            @if (_playlist.SyncError != null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_playlist.SyncError</MudAlert>
            }
            else if (_playlist.SyncedAt is { } synced)
            {
                <MudText Typo="Typo.caption" Style="opacity:.6">zuletzt abgeglichen @synced.ToLocalTime().ToString("g")</MudText>
            }
            <div class="d-flex flex-wrap mt-2" style="gap:8px">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew"
                           Href="@(_playlist.SpotifyId == MusicManager.Core.Services.SpotifyUserClient.LikedSongsId
                                       ? "https://open.spotify.com/collection/tracks"
                                       : $"https://open.spotify.com/playlist/{_playlist.SpotifyId}")" Target="_blank">In Spotify öffnen</MudButton>
                <ActionButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Sync" Disabled="Sync.State.Running"
                           OnClick="() => Sync.Request()">Jetzt abgleichen</ActionButton>
                <ActionButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="Remove">Entfernen</ActionButton>
            </div>
        </div>
    </div>
</MudPaper>

<MudChipSet T="Show" SelectedValue="_show" SelectedValueChanged="v => _show = v" SelectionMode="SelectionMode.SingleSelection" CheckMark="true"
            Size="Size.Small" Class="mb-2">
    <MudChip T="Show" Value="Show.All" Text="@($"Alle ({_rows.Count})")" Variant="Variant.Outlined" />
    <MudChip T="Show" Value="Show.Present" Text="@($"Vorhanden ({Matched})")" Variant="Variant.Outlined" />
    <MudChip T="Show" Value="Show.Missing" Text="@($"Fehlend ({_rows.Count - Matched})")" Variant="Variant.Outlined" />
</MudChipSet>

<div class="card-list">
    @foreach (var row in Visible)
    {
        <MudPaper Outlined="true" Class="@($"pa-2 {(row.Track == null ? "spotify-missing" : "")}")">
            <div class="d-flex align-start" style="gap:4px">
                <MudText Typo="Typo.caption" Style="width:32px;flex-shrink:0;opacity:.6;padding-top:14px;text-align:right">@(row.Position + 1)</MudText>
                <SongCard Song="row.Song" />
                @if (row.Track is { } track)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" OnClick="() => Player.Play(track)" aria-label="Abspielen" />
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Style="flex-shrink:0">fehlt</MudChip>
                    @if (MusicFab.IsConfigured && row.SpotifyTrackId is { } spotifyId)
                    {
                        <MudTooltip Text="Mit MusicFab laden">
                            <ActionIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" aria-label="Mit MusicFab laden"
                                           Disabled="_requested.Contains(spotifyId)" OnClick="() => RequestFromMusicFab(spotifyId)" />
                        </MudTooltip>
                    }
                }
            </div>
        </MudPaper>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private enum Show { All, Present, Missing }

    private sealed record Row(int Position, SongInfo Song, LibraryTrack? Track, string? SpotifyTrackId = null);

    private readonly HashSet<string> _requested = [];

    private SpotifyPlaylist? _playlist;
    private List<Row> _rows = [];
    private Show _show = Show.All;
    private bool _missing;

    private int Matched => _rows.Count(r => r.Track != null);

    private IEnumerable<Row> Visible => _show switch
    {
        Show.Present => _rows.Where(r => r.Track != null),
        Show.Missing => _rows.Where(r => r.Track == null),
        _ => _rows,
    };

    protected override async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _playlist = await db.SpotifyPlaylists.AsNoTracking().Include(p => p.Tracks).FirstOrDefaultAsync(p => p.Id == Id);
        _missing = _playlist == null;
        if (_playlist == null) return;

        var matcher = SpotifyMatcher.For(await Catalog.GetAsync());
        var tracks = (await Library.GetTracksAsync()).ToDictionary(t => t.RelativePath);
        _rows = _playlist.Tracks.OrderBy(t => t.Position).Select(t =>
        {
            // In the library: shown like any library song (and playable); missing: as Spotify lists it, greyed.
            if (matcher.Match(t) is { } song && tracks.TryGetValue(song.RelativePath, out var track))
                return new Row(t.Position, SongInfo.From(track), track);
            return new Row(t.Position, new SongInfo
            {
                Title = t.Title, Artist = string.Join(", ", t.Artists), Artists = t.Artists, Album = t.Album,
                Duration = SongInfo.FormatLength(t.DurationMs / 1000.0), CoverUrl = t.ImageUrl,
            }, null, t.SpotifyTrackId);
        }).ToList();
    }

    /// <summary>A missing track: MusicFab downloads it from Spotify into the inbox (MusicFab must be logged in to Spotify).</summary>
    private async Task RequestFromMusicFab(string spotifyTrackId)
    {
        _requested.Add(spotifyTrackId);
        try
        {
            await MusicFab.RequestAsync($"https://open.spotify.com/track/{spotifyTrackId}", $"Spotify-Playlist „{_playlist!.Name}“", CancellationToken.None);
            Snackbar.Add("An MusicFab übergeben; der Stand steht unter „MusicFab“.", Severity.Success);
        }
        catch (MusicFabException ex)
        {
            _requested.Remove(spotifyTrackId);
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task Remove()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Playlist entfernen",
            $"„{_playlist!.Name}“ wird aus dem Music Manager und aus Symfonium entfernt. Auf Spotify bleibt sie, wie sie ist.",
            yesText: "Entfernen", cancelText: "Abbrechen");
        if (ok != true) return;
        await Sync.RemoveAsync(_playlist.Id);
        Nav.NavigateTo("playlists");
    }
}
