@page "/duplikate"
@inherits LivePage
@using MusicManager.Core.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ReviewService Review
@inject SameAudioChecker SameAudio
@inject AudioTools Audio
@inject Storage Storage
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Duplikate – Music Manager</PageTitle>

@* On a desktop the page fills the window and only the list and the comparison scroll, each on its own: the comparison
   stays in view while going through the list (see .dup-page in app.css). *@
<div class="dup-page">
<PageHeader Title="Duplikate" />

<MudTabs Outlined="true" Border="true" TabPanelsClass="pa-4">
    <MudTabPanel Text="Neu eingegangen" BadgeData="@(_files.Count > 0 ? _files.Count : null)">
        @if (_files.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">Keine möglichen Duplikate offen.</MudAlert>
        }
        else
        {
            <div class="dup-split">
                @* Filter and progress above the list they belong to; the comparison starts at the top. *@
                <div class="dup-list">
                    @if (SameAudio.State.Running)
                    {
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Audio wird verglichen: @SameAudio.State.Done von @SameAudio.State.Total
                        </MudText>
                        <MudProgressLinear Value="@(SameAudio.State.Total == 0 ? 0 : 100.0 * SameAudio.State.Done / SameAudio.State.Total)" Class="mb-3" />
                    }

                    @* Discard every new file that is at least this similar to a library file; the library files stay. *@
                    <div class="d-flex flex-wrap align-center mb-3" style="gap:8px">
                        <MudNumericField T="int" @bind-Value="_percent" Label="Ähnlichkeit ab (%)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Min="50" Max="100" Style="max-width:150px" />
                        <MudTooltip Text="Neue Dateien, deren Audio über die ganze Länge mindestens so ähnlich wie eine gleich lange Datei in der Bibliothek ist, kommen in den Papierkorb. Die vorhandenen bleiben. Klingt ein Abschnitt anders (z. B. Kommentar), bleibt die Datei zur Prüfung.">
                            <ActionButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.DeleteSweep"
                                          OnClick="DiscardSimilar" Disabled="@(_busy || SimilarFiles.Count == 0)">
                                @SimilarFiles.Count Duplikate ab @_percent % verwerfen
                            </ActionButton>
                        </MudTooltip>
                    </div>

                    <div class="d-flex flex-wrap align-center mb-3" style="gap:8px">
                        <MudChipSet T="Show" SelectedValue="_show" SelectedValueChanged="SetShow" SelectionMode="SelectionMode.SingleSelection" CheckMark="true"
                                    Size="Size.Small">
                            <MudChip T="Show" Value="Show.All" Text="@($"Alle ({_files.Count})")" Variant="Variant.Outlined" />
                            <MudChip T="Show" Value="Show.Same" Text="@($"Gleiche Aufnahme ({SameFiles.Count})")" Variant="Variant.Outlined" />
                            <MudChip T="Show" Value="Show.Check" Text="@($"Zu prüfen ({_files.Count - SameFiles.Count})")" Variant="Variant.Outlined" />
                        </MudChipSet>
                        @if (_show == Show.Same && SameFiles.Count > 0)
                        {
                            <ActionButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.DeleteSweep"
                                       OnClick="DiscardSame" Disabled="_busy">
                                Alle @SameFiles.Count neuen Dateien verwerfen
                            </ActionButton>
                        }
                    </div>

                    <MudPaper Outlined="true" Class="dup-list-items">
                        @if (!Visible.Any())
                        {
                            <MudText Typo="Typo.body2" Class="pa-3" Style="opacity:.7">Nichts in dieser Ansicht.</MudText>
                        }
                        <MudList T="int" SelectedValue="_selectedId" SelectedValueChanged="Select" Dense="true">
                            @foreach (var f in Visible)
                            {
                                <MudListItem T="int" Value="f.Id">
                                    <div class="d-flex align-center" style="gap:4px">
                                        <div style="min-width:0;flex:1"><TrackSummary File="f" /></div>
                                        @if (SameAudioChecker.MostSimilar(f)?.AudioSimilarity is { } similarity)
                                        {
                                            <MudText Typo="Typo.caption" Style="opacity:.7;white-space:nowrap">@SameAudioChecker.Percent(similarity) %</MudText>
                                        }
                                        @if (SameAudioChecker.IsSafeToDiscard(f))
                                        {
                                            <MudTooltip Text="Gleiche Aufnahme wie in der Bibliothek">
                                                <MudIcon Icon="@Icons.Material.Filled.GraphicEq" Color="Color.Success" Size="Size.Small" />
                                            </MudTooltip>
                                        }
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                </div>

                <div class="dup-detail">
                    @if (_file != null && _match != null)
                    {
                        var t = _file.FinalTags ?? new TagSet();

                        @if (DuplicateMatches.Count > 1)
                        {
                            <MudChipSet T="int" SelectedValue="_match.LibraryEntryId" SelectedValueChanged="SelectMatch" SelectionMode="SelectionMode.SingleSelection" Class="mb-2">
                                @foreach (var m in DuplicateMatches)
                                {
                                    <MudChip T="int" Value="m.LibraryEntryId" Text="@m.RelativePath" />
                                }
                            </MudChipSet>
                        }

                        @* Side by side where there is room: one above the other they would cost height the comparison needs. *@
                        <div class="dup-alerts mb-3">
                            <MudAlert Severity="Severity.Warning" Dense="true">@_match.Reason</MudAlert>
                            <MudAlert Severity="@(_match.SameAudio switch { true => Severity.Success, false => Severity.Error, _ => Severity.Info })" Dense="true">
                                @(_match.AudioCheck ?? "Audio noch nicht verglichen")
                            </MudAlert>
                        </div>

                        <MudSimpleTable Dense="true" Bordered="true" Class="mb-3 compare-table">
                            <thead>
                                @* The covers sit in the column heads instead of a row of their own. *@
                                <tr>
                                    <th></th>
                                    <th>
                                        <div class="compare-head">
                                            <img src="@($"api/files/{_file.Id}/cover?which=original")" alt="Cover neu" class="compare-cover rounded" />
                                            <span>Neu (Eingang)</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="compare-head">
                                            <img src="@($"api/library/{_match.LibraryEntryId}/cover")" alt="Cover vorhanden" class="compare-cover rounded" />
                                            <span>Vorhanden (Bibliothek)</span>
                                        </div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @CompareRow("Titel", t.Title, _match.Title)
                                @CompareRow("Künstler", t.Artist, _match.Artist)
                                @CompareRow("Album", t.Album, _match.Album)
                                @CompareRow("Datum", t.Date, _match.Date)
                                @CompareRow("Format", _file.Codec, _match.Codec)
                                @CompareRow("Bitrate", Kbps(_file.BitrateKbps), Kbps(_match.BitrateKbps), Better(_file.BitrateKbps, _match.BitrateKbps))
                                @CompareRow("Dauer", Length(_file.DurationSeconds), Length(_match.DurationSeconds))
                                @CompareRow("Dateigröße", Mb(_file.FileSize), Mb(_match.FileSize))
                                @CompareRow("Quelle", Source(_file), _match.TagSource ?? "nicht von diesem Tool")
                                <tr>
                                    <td>Release</td>
                                    <td>@ReleaseLink(t.MbReleaseId)</td>
                                    <td>@ReleaseLink(_match.MbReleaseId)</td>
                                </tr>
                                <tr>
                                    <td>Pfad</td>
                                    <td class="mono" style="opacity:.7">@_file.RelativePath<br />→ @_file.TargetPath</td>
                                    <td class="mono" style="opacity:.7">@_match.RelativePath</td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>

                        <AbPlayer @ref="_player" UrlA="@($"api/audio/file/{_file.Id}")" UrlB="@($"api/audio/library/{_match.LibraryEntryId}")"
                                  MeasureLoudness="MeasureLoudness" />

                        @* What each choice does is in the tooltips (and the confirmation of "Neue behalten"): a paragraph
                           below the buttons would push the comparison past the window. *@
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mt-3">
                            <MudTooltip Text="Die vorhandene Datei kommt in den Papierkorb. Die neue übernimmt ihre Song-ID: Wiedergabezähler, Favoriten und Playlist-Einträge bleiben erhalten.">
                                <ActionButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="KeepNew" Disabled="_busy">
                                    Neue behalten (ersetzt vorhandene)
                                </ActionButton>
                            </MudTooltip>
                            <MudTooltip Text="Die neue Datei kommt in den Papierkorb.">
                                <ActionButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Inventory2" OnClick="KeepExisting" Disabled="_busy">
                                    Vorhandene behalten
                                </ActionButton>
                            </MudTooltip>
                            <MudTooltip Text="Die neue Datei wird zusätzlich einsortiert.">
                                <ActionButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.LibraryAdd" OnClick="KeepBoth" Disabled="_busy">
                                    Beide behalten
                                </ActionButton>
                            </MudTooltip>
                        </MudStack>

                        @if (_file.Duplicates.Any(d => d.Kind == DuplicateKind.OtherVersion))
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-4">Mögliche andere Versionen (kein Duplikat)</MudText>
                            @foreach (var o in _file.Duplicates.Where(d => d.Kind == DuplicateKind.OtherVersion))
                            {
                                <SongCard Song="SongInfo.From(o)" Class="mt-2" />
                            }
                        }
                    }
                </div>
            </div>
        }
    </MudTabPanel>

    <MudTabPanel Text="Bibliothek prüfen">
        <LibraryDuplicates />
    </MudTabPanel>
</MudTabs>
</div>

@code {
    private List<TrackFile> _files = [];
    private int _selectedId;
    private TrackFile? _file;
    private DuplicateMatch? _match;
    private AbPlayer? _player;
    private bool _busy;
    private Show _show = Show.All;

    private enum Show { All, Same, Check }

    private List<TrackFile> SameFiles => _files.Where(SameAudioChecker.IsSafeToDiscard).ToList();

    private IEnumerable<TrackFile> Visible => _show switch
    {
        Show.Same => _files.Where(SameAudioChecker.IsSafeToDiscard),
        Show.Check => _files.Where(f => !SameAudioChecker.IsSafeToDiscard(f)),
        _ => _files,
    };

    private List<DuplicateMatch> DuplicateMatches => _file?.Duplicates.Where(d => d.Kind == DuplicateKind.Duplicate).ToList() ?? [];

    protected override async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _files = await db.Files.AsNoTracking().Where(f => f.Status == FileStatus.Duplicate).OrderBy(f => f.RelativePath).ToListAsync();
        if (_files.All(f => f.Id != _selectedId))
            _selectedId = _files.FirstOrDefault()?.Id ?? 0;

        var selected = _files.FirstOrDefault(f => f.Id == _selectedId);
        if (selected?.Id != _file?.Id)
            _match = selected?.Duplicates.FirstOrDefault(d => d.Kind == DuplicateKind.Duplicate);
        _file = selected;
    }

    private Task SetShow(Show show)
    {
        _show = show;
        // Keep the detail on a file of the chosen view.
        if (Visible.All(f => f.Id != _selectedId) && Visible.FirstOrDefault() is { } first) return Select(first.Id);
        return Task.CompletedTask;
    }

    private async Task DiscardSame()
    {
        var ids = SameFiles.Select(f => f.Id).ToList();
        var ok = await Dialogs.ShowMessageBoxAsync("Gleiche Aufnahmen verwerfen",
            $"Bei {ids.Count} neuen Dateien ist das Audio dasselbe wie in der Bibliothek, nur anders kodiert. Die neuen Dateien kommen " +
            "in den Papierkorb, die vorhandenen bleiben, wie sie sind.",
            yesText: "Verwerfen", cancelText: "Abbrechen");
        if (ok != true) return;

        _busy = true;
        try
        {
            if (_player != null) await _player.StopAsync();
            var count = await Review.DiscardSameAudioAsync(ids);
            Snackbar.Add($"{count} neue Dateien verworfen, die vorhandenen Versionen bleiben.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private int _percent = SameAudioChecker.DefaultDiscardPercent;

    private List<TrackFile> SimilarFiles => _files.Where(f => SameAudioChecker.IsAtLeast(f, _percent)).ToList();

    private async Task DiscardSimilar()
    {
        var percent = _percent;
        var ids = SimilarFiles.Select(f => f.Id).ToList();
        var count = ids.Count;
        var ok = await Dialogs.ShowMessageBoxAsync("Duplikate verwerfen",
            $"Bei {count} neuen Dateien ist das Audio zu mindestens {percent} % dasselbe wie bei einer gleich langen Datei in der " +
            "Bibliothek, ohne Abschnitt, der anders klingt. Die neuen Dateien kommen in den Papierkorb, die vorhandenen bleiben, wie sie sind.",
            yesText: "Verwerfen", cancelText: "Abbrechen");
        if (ok != true) return;

        _busy = true;
        try
        {
            if (_player != null) await _player.StopAsync();
            var discarded = await Review.DiscardSimilarAsync(ids, percent);
            Snackbar.Add($"{discarded} neue Dateien verworfen, die vorhandenen Versionen bleiben.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task Select(int id)
    {
        _selectedId = id;
        _file = _files.FirstOrDefault(f => f.Id == id);
        _match = DuplicateMatches.FirstOrDefault();
        return Task.CompletedTask;
    }

    private Task SelectMatch(int entryId)
    {
        _match = DuplicateMatches.FirstOrDefault(m => m.LibraryEntryId == entryId) ?? _match;
        return Task.CompletedTask;
    }

    private async Task<(double?, double?)> MeasureLoudness()
    {
        var newPath = new[] { Storage.InboxPath(_file!.RelativePath), _file.TrashPath }.FirstOrDefault(p => p != null && File.Exists(p));
        var oldPath = Storage.LibraryPath(_match!.RelativePath);
        var a = newPath == null ? null : await Audio.LoudnessAsync(newPath, CancellationToken.None);
        var b = File.Exists(oldPath) ? await Audio.LoudnessAsync(oldPath, CancellationToken.None) : null;
        return (a, b);
    }

    private async Task Decide(Func<Task> action, string message)
    {
        _busy = true;
        try
        {
            if (_player != null) await _player.StopAsync();
            await action();
            Snackbar.Add(message, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task KeepNew()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Neue behalten",
            $"Die vorhandene Datei {_match!.RelativePath} kommt in den Papierkorb, die neue Datei übernimmt ihren Platz.",
            yesText: "Ersetzen", cancelText: "Abbrechen");
        if (ok != true) return;
        await Decide(() => Review.ResolveDuplicateAsync(_file!.Id, DuplicateDecision.KeepNew, _match.LibraryEntryId), "Neue Version wird einsortiert.");
    }

    private Task KeepExisting() =>
        Decide(() => Review.ResolveDuplicateAsync(_file!.Id, DuplicateDecision.KeepExisting), "Vorhandene Version behalten, neue Datei im Papierkorb.");

    private Task KeepBoth() =>
        Decide(() => Review.ResolveDuplicateAsync(_file!.Id, DuplicateDecision.KeepBoth), "Beide Versionen werden behalten.");

    private static RenderFragment CompareRow(string label, string? a, string? b, int better = 0) => __builder =>
    {
        var differs = !string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
        <tr>
            <td>@label</td>
            <td style="@(better > 0 ? "color:var(--mud-palette-success)" : differs ? "font-weight:600" : null)">@a</td>
            <td style="@(better < 0 ? "color:var(--mud-palette-success)" : differs ? "font-weight:600" : null)">@b</td>
        </tr>
    };

    private static int Better(int? a, int? b) => a == null || b == null || a == b ? 0 : a > b ? 1 : -1;

    private static RenderFragment ReleaseLink(string? id) => __builder =>
    {
        if (id != null)
        {
            <MudLink Href="@($"https://musicbrainz.org/release/{id}")" Target="_blank">MusicBrainz</MudLink>
        }
        else
        {
            <span style="opacity:.6">–</span>
        }
    };

    private static string Source(TrackFile f) => f.ExternalSource ?? (f.ManuallyTagged ? "manuell" : "MusicBrainz") + " (neu)";
    private static string? Kbps(int? v) => v == null ? null : $"{v} kbps";
    private static string? Mb(long bytes) => bytes <= 0 ? null : $"{bytes / 1024.0 / 1024.0:0.0} MB";
    private static string Length(double? s) => s is > 0 ? TimeSpan.FromSeconds(s.Value).ToString(s >= 3600 ? @"h\:mm\:ss" : @"m\:ss") : "–";
}
