@page "/duplikate"
@inherits LivePage
@using MusicManager.Core.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ReviewService Review
@inject AudioTools Audio
@inject Storage Storage
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Duplikate – Music Manager</PageTitle>

<PageHeader Title="Duplikate" />

<MudTabs Outlined="true" Border="true" TabPanelsClass="pa-4">
    <MudTabPanel Text="Neu eingegangen" BadgeData="@(_files.Count > 0 ? _files.Count : null)">
        @if (_files.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">Keine möglichen Duplikate offen.</MudAlert>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Outlined="true">
                        <MudList T="int" SelectedValue="_selectedId" SelectedValueChanged="Select" Dense="true">
                            @foreach (var f in _files)
                            {
                                <MudListItem T="int" Value="f.Id">
                                    <TrackSummary File="f" />
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="8">
                    @if (_file != null && _match != null)
                    {
                        var t = _file.FinalTags ?? new TagSet();

                        @if (DuplicateMatches.Count > 1)
                        {
                            <MudChipSet T="int" SelectedValue="_match.LibraryEntryId" SelectedValueChanged="SelectMatch" SelectionMode="SelectionMode.SingleSelection" Class="mb-2">
                                @foreach (var m in DuplicateMatches)
                                {
                                    <MudChip T="int" Value="m.LibraryEntryId" Text="@m.RelativePath" />
                                }
                            </MudChipSet>
                        }

                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@_match.Reason</MudAlert>

                        <MudSimpleTable Dense="true" Bordered="true" Class="mb-3">
                            <thead>
                                <tr><th></th><th>Neu (Eingang)</th><th>Vorhanden (Bibliothek)</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td></td>
                                    <td><MudImage Src="@($"api/files/{_file.Id}/cover?which=original")" Width="140" Height="140" ObjectFit="ObjectFit.Cover" Class="rounded" /></td>
                                    <td><MudImage Src="@($"api/library/{_match.LibraryEntryId}/cover")" Width="140" Height="140" ObjectFit="ObjectFit.Cover" Class="rounded" /></td>
                                </tr>
                                @CompareRow("Titel", t.Title, _match.Title)
                                @CompareRow("Künstler", t.Artist, _match.Artist)
                                @CompareRow("Album", t.Album, _match.Album)
                                @CompareRow("Datum", t.Date, _match.Date)
                                @CompareRow("Format", _file.Codec, _match.Codec)
                                @CompareRow("Bitrate", Kbps(_file.BitrateKbps), Kbps(_match.BitrateKbps), Better(_file.BitrateKbps, _match.BitrateKbps))
                                @CompareRow("Dauer", Length(_file.DurationSeconds), Length(_match.DurationSeconds))
                                @CompareRow("Dateigröße", Mb(_file.FileSize), Mb(_match.FileSize))
                                @CompareRow("Quelle", Source(_file), _match.TagSource ?? "nicht von diesem Tool")
                                <tr>
                                    <td>Release</td>
                                    <td>@ReleaseLink(t.MbReleaseId)</td>
                                    <td>@ReleaseLink(_match.MbReleaseId)</td>
                                </tr>
                                <tr>
                                    <td>Pfad</td>
                                    <td class="mono" style="opacity:.7">@_file.RelativePath<br />→ @_file.TargetPath</td>
                                    <td class="mono" style="opacity:.7">@_match.RelativePath</td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>

                        <AbPlayer @ref="_player" UrlA="@($"api/audio/file/{_file.Id}")" UrlB="@($"api/audio/library/{_match.LibraryEntryId}")"
                                  MeasureLoudness="MeasureLoudness" />

                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="my-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="KeepNew" Disabled="_busy">
                                Neue behalten (ersetzt vorhandene)
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Inventory2" OnClick="KeepExisting" Disabled="_busy">
                                Vorhandene behalten
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.LibraryAdd" OnClick="KeepBoth" Disabled="_busy">
                                Beide behalten
                            </MudButton>
                        </MudStack>
                        <MudText Typo="Typo.caption" Style="opacity:.7">
                            Ersetzte oder verworfene Dateien landen im Papierkorb. „Neue behalten“ übernimmt den Pfad der vorhandenen Datei,
                            damit Navidrome Wiedergabezähler, Favoriten und Playlists möglichst behält.
                        </MudText>

                        @if (_file.Duplicates.Any(d => d.Kind == DuplicateKind.OtherVersion))
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-4">Mögliche andere Versionen (kein Duplikat)</MudText>
                            @foreach (var o in _file.Duplicates.Where(d => d.Kind == DuplicateKind.OtherVersion))
                            {
                                <MudText Typo="Typo.body2">@o.Artist – @o.Title (@o.Album) <span class="mono" style="opacity:.6">@o.RelativePath</span></MudText>
                            }
                        }
                    }
                </MudItem>
            </MudGrid>
        }
    </MudTabPanel>

    <MudTabPanel Text="Bibliothek prüfen">
        <LibraryDuplicates />
    </MudTabPanel>
</MudTabs>

@code {
    private List<TrackFile> _files = [];
    private int _selectedId;
    private TrackFile? _file;
    private DuplicateMatch? _match;
    private AbPlayer? _player;
    private bool _busy;

    private List<DuplicateMatch> DuplicateMatches => _file?.Duplicates.Where(d => d.Kind == DuplicateKind.Duplicate).ToList() ?? [];

    protected override async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _files = await db.Files.AsNoTracking().Where(f => f.Status == FileStatus.Duplicate).OrderBy(f => f.RelativePath).ToListAsync();
        if (_files.All(f => f.Id != _selectedId))
            _selectedId = _files.FirstOrDefault()?.Id ?? 0;

        var selected = _files.FirstOrDefault(f => f.Id == _selectedId);
        if (selected?.Id != _file?.Id)
            _match = selected?.Duplicates.FirstOrDefault(d => d.Kind == DuplicateKind.Duplicate);
        _file = selected;
    }

    private Task Select(int id)
    {
        _selectedId = id;
        _file = _files.FirstOrDefault(f => f.Id == id);
        _match = DuplicateMatches.FirstOrDefault();
        return Task.CompletedTask;
    }

    private Task SelectMatch(int entryId)
    {
        _match = DuplicateMatches.FirstOrDefault(m => m.LibraryEntryId == entryId) ?? _match;
        return Task.CompletedTask;
    }

    private async Task<(double?, double?)> MeasureLoudness()
    {
        var newPath = new[] { Storage.InboxPath(_file!.RelativePath), _file.TrashPath }.FirstOrDefault(p => p != null && File.Exists(p));
        var oldPath = Storage.LibraryPath(_match!.RelativePath);
        var a = newPath == null ? null : await Audio.LoudnessAsync(newPath, CancellationToken.None);
        var b = File.Exists(oldPath) ? await Audio.LoudnessAsync(oldPath, CancellationToken.None) : null;
        return (a, b);
    }

    private async Task Decide(Func<Task> action, string message)
    {
        _busy = true;
        try
        {
            if (_player != null) await _player.StopAsync();
            await action();
            Snackbar.Add(message, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task KeepNew()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Neue behalten",
            $"Die vorhandene Datei {_match!.RelativePath} kommt in den Papierkorb, die neue Datei übernimmt ihren Platz.",
            yesText: "Ersetzen", cancelText: "Abbrechen");
        if (ok != true) return;
        await Decide(() => Review.ResolveDuplicateAsync(_file!.Id, DuplicateDecision.KeepNew, _match.LibraryEntryId), "Neue Version wird einsortiert.");
    }

    private Task KeepExisting() =>
        Decide(() => Review.ResolveDuplicateAsync(_file!.Id, DuplicateDecision.KeepExisting), "Vorhandene Version behalten, neue Datei im Papierkorb.");

    private Task KeepBoth() =>
        Decide(() => Review.ResolveDuplicateAsync(_file!.Id, DuplicateDecision.KeepBoth), "Beide Versionen werden behalten.");

    private static RenderFragment CompareRow(string label, string? a, string? b, int better = 0) => __builder =>
    {
        var differs = !string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
        <tr>
            <td>@label</td>
            <td style="@(better > 0 ? "color:var(--mud-palette-success)" : differs ? "font-weight:600" : null)">@a</td>
            <td style="@(better < 0 ? "color:var(--mud-palette-success)" : differs ? "font-weight:600" : null)">@b</td>
        </tr>
    };

    private static int Better(int? a, int? b) => a == null || b == null || a == b ? 0 : a > b ? 1 : -1;

    private static RenderFragment ReleaseLink(string? id) => __builder =>
    {
        if (id != null)
        {
            <MudLink Href="@($"https://musicbrainz.org/release/{id}")" Target="_blank">MusicBrainz</MudLink>
        }
        else
        {
            <span style="opacity:.6">–</span>
        }
    };

    private static string Source(TrackFile f) => f.ExternalSource ?? (f.ManuallyTagged ? "manuell" : "MusicBrainz") + " (neu)";
    private static string? Kbps(int? v) => v == null ? null : $"{v} kbps";
    private static string? Mb(long bytes) => bytes <= 0 ? null : $"{bytes / 1024.0 / 1024.0:0.0} MB";
    private static string Length(double? s) => s is > 0 ? TimeSpan.FromSeconds(s.Value).ToString(s >= 3600 ? @"h\:mm\:ss" : @"m\:ss") : "–";
}
