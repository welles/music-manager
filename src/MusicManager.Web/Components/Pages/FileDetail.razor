@page "/datei/{Id:int}"
@inherits LivePage
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ReviewService Review
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(_file?.FileName ?? "Datei") – Music Manager</PageTitle>

@if (_file == null)
{
    <MudProgressLinear Indeterminate="true" />
    return;
}

<PageHeader Title="@TrackSummary.TitleOf(_file)" UseHistory="true">
    <Badges>
    <StatusChip Status="_file.Status" />
    <DecisionChip Decision="_file.Decision" />
    @if (_file.ManuallyTagged)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">manuell getaggt</MudChip>
    }
    </Badges>
    <Actions>
    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
        @if (_file.Status == FileStatus.NeedsReview && _file.FinalTags != null && _file.SelectedCandidateKey != null && !IsDuplicate)
        {
            <MudButton StartIcon="@Icons.Material.Filled.Check" Color="Color.Success" OnClick="Approve">Vorschau bestätigen</MudButton>
        }
        <MudButton StartIcon="@Icons.Material.Filled.Search" OnClick="SearchRelease" Disabled="!IsOpen">Release suchen</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Edit" Href="@($"manuell?ids={_file.Id}")" Disabled="!IsOpen">Manuell taggen</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Replay" OnClick="Retry" Disabled="!CanRetry">Erneut verarbeiten</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="Discard" Disabled="!IsOpen">Verwerfen</MudButton>
    </MudButtonGroup>
    </Actions>
</PageHeader>

<MudPaper Outlined="true" Class="pa-3 mb-3">
    <TrackSummary File="_file" Large="true" ShowTitle="false" />
</MudPaper>
@if (_file.StatusReason != null)
{
    <MudAlert Severity="@(_file.Status == FileStatus.Error ? Severity.Error : Severity.Info)" Dense="true" Class="mb-2">@_file.StatusReason</MudAlert>
}

<MudTabs Outlined="true" Border="true" TabPanelsClass="pa-4" @bind-ActivePanelIndex="_tab">
    <MudTabPanel Text="Kandidaten" BadgeData="@(CandidateRows.Count > 0 ? CandidateRows.Count : null)">
        @if (CandidateRows.Count == 0)
        {
            <MudText>Keine Kandidaten von MusicBrainz, Spotify oder Deezer. Nutze „Release suchen“ oder „Manuell taggen“.</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-2">
                „Vorschau“ zeigt die Tags eines Kandidaten im Tab „Tags“, ohne etwas zu ändern; „Wählen“ übernimmt ihn.
                Bei Spotify/Deezer werden Tags und Cover der Quelle mit den eigenen Regeln verwendet, die Datei gilt danach als manuell getaggt.
            </MudText>
            <MudTable Items="CandidateRows" Dense="true" Hover="true" T="CandidateRow">
                <HeaderContent>
                    <MudTh>Quelle</MudTh>
                    <MudTh>Punkte</MudTh>
                    <MudTh>Release</MudTh>
                    <MudTh>Datum / Land</MudTh>
                    <MudTh>Typ</MudTh>
                    <MudTh>Track</MudTh>
                    <MudTh>Aufnahme</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    @if (context.MusicBrainz is { } c)
                    {
                        <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">MusicBrainz</MudChip></MudTd>
                        <MudTd>
                            <MudTooltip Text="Erreichte Punkte von den für diese Datei maximal möglichen. Das ist keine Erkennungssicherheit – die steht bei der Aufnahme.">
                                <MudText Typo="Typo.body2" Color="@(c.Key == _file.SelectedCandidateKey ? Color.Primary : Color.Default)" Style="white-space:nowrap">
                                    <b>@c.Score.ToString("0.#")</b>@(c.MaxScore > 0 ? $" / {c.MaxScore:0.#}" : "")
                                </MudText>
                            </MudTooltip>
                        </MudTd>
                        <MudTd>
                            <MudLink Href="@($"https://musicbrainz.org/release/{c.Release.ReleaseId}")" Target="_blank">@c.Release.Title</MudLink>
                            <MudText Typo="Typo.caption" Class="d-block">@c.Release.ArtistString</MudText>
                        </MudTd>
                        <MudTd>@c.Release.Date · @c.Release.Country</MudTd>
                        <MudTd>
                            @string.Join(" + ", new[] { c.Release.PrimaryType }.Concat(c.Release.SecondaryTypes).OfType<string>())
                            <MudText Typo="Typo.caption" Class="d-block">@c.Release.Status · @string.Join(", ", c.Release.Formats)</MudText>
                        </MudTd>
                        <MudTd>@c.Release.TrackPosition/@c.Release.TrackCount</MudTd>
                        <MudTd>
                            @c.RecordingArtist – @c.RecordingTitle
                            <MudText Typo="Typo.caption" Class="d-block">
                                @c.MatchSource @c.MatchScore.ToString("P0") · @FormatLength(c.RecordingLengthSeconds) (Datei @FormatLength(_file.DurationSeconds))
                            </MudText>
                        </MudTd>
                        <MudTd Style="white-space:nowrap">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility" OnClick="() => Preview(c)">Vorschau</MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" title="Punkte" OnClick="() => ToggleBreakdown(c.Key)" />
                            @if (IsOpen)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => Choose(c)">Wählen</MudButton>
                            }
                        </MudTd>
                    }
                    else if (context.External is { } m)
                    {
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(m.Source == "spotify" ? Color.Success : Color.Info)">
                                @MatchingPipeline.SourceName(m.Source)
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2" Style="white-space:nowrap" Color="@(m.FromTagLink || m.Score >= 0.95 ? Color.Success : Color.Default)">
                                @(m.FromTagLink ? "Link aus den Tags" : $"{m.Score:P0} Übereinstimmung")
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <div class="d-flex align-center" style="gap:8px">
                                @if (m.CoverUrl != null)
                                {
                                    <MudImage Src="@m.CoverUrl" Width="40" Height="40" ObjectFit="ObjectFit.Cover" Class="rounded flex-shrink-0" Alt="Cover" />
                                }
                                <div>
                                    @if (m.Url != null)
                                    {
                                        <MudLink Href="@m.Url" Target="_blank">@m.Album</MudLink>
                                    }
                                    else
                                    {
                                        @m.Album
                                    }
                                    <MudText Typo="Typo.caption" Class="d-block">@(m.Label ?? "")</MudText>
                                </div>
                            </div>
                        </MudTd>
                        <MudTd>@m.ReleaseDate</MudTd>
                        <MudTd>@m.AlbumType</MudTd>
                        <MudTd>@(m.TrackNumber != null ? $"{m.TrackNumber}/{m.TrackCount}" : "")</MudTd>
                        <MudTd>
                            @string.Join(", ", m.Artists)@(m.FeaturedArtists.Count > 0 ? $" feat. {string.Join(", ", m.FeaturedArtists)}" : "") – @m.Title
                            <MudText Typo="Typo.caption" Class="d-block">
                                @FormatLength(m.DurationSeconds) (Datei @FormatLength(_file.DurationSeconds))@(m.Isrc != null ? $" · ISRC {m.Isrc}" : "")@(m.Genres.Count > 0 ? $" · {string.Join(", ", m.Genres)}" : "")
                            </MudText>
                        </MudTd>
                        <MudTd Style="white-space:nowrap">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility" OnClick="() => PreviewExternal(m)">Vorschau</MudButton>
                            @if (IsOpen)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => ApplyExternal(m)">Wählen</MudButton>
                            }
                        </MudTd>
                    }
                </RowTemplate>
                <ChildRowContent>
                    @if (context.MusicBrainz is { } c && _expanded.Contains(c.Key))
                    {
                        <MudTr>
                            <td colspan="8">
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="pa-2">
                                    @foreach (var (name, value, max) in BreakdownRows(c))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                 Color="@(value < 0 ? Color.Error : max != null && value >= max - 0.05 ? Color.Success : Color.Warning)">
                                            @name: @value.ToString("0.#")@(max != null ? $" / {max:0.#}" : "")
                                        </MudChip>
                                    }
                                </MudStack>
                            </td>
                        </MudTr>
                    }
                </ChildRowContent>
            </MudTable>
        }
    </MudTabPanel>

    <MudTabPanel Text="Tags">
        <TagDiff File="_file" Preview="_preview" PreviewLabel="@_previewLabel" OnClearPreview="() => _preview = null" />
    </MudTabPanel>

    <MudTabPanel Text="KI" Icon="@Icons.Material.Filled.AutoAwesome" Disabled="_file.AiDecision == null && _file.AiSuggestion == null">
        @if (_file.AiDecision is { } d)
        {
            <MudText Typo="Typo.h6">Release-Entscheidung</MudText>
            <MudSimpleTable Dense="true" Class="mb-4">
                <tbody>
                    <tr><td>Entscheidung</td><td>@(d.Decision == "choose" ? "Release gewählt" : "Manuelle Prüfung empfohlen") @(d.Accepted ? "(übernommen)" : "(nicht übernommen)")</td></tr>
                    <tr><td>Sicherheit</td><td>@d.Confidence.ToString("P0")</td></tr>
                    <tr><td>Release</td><td>@(_file.Candidates.FirstOrDefault(c => c.Release.ReleaseId == d.ReleaseId)?.Release.Title ?? d.ReleaseId)</td></tr>
                    <tr><td>Begründung</td><td>@d.Reasoning</td></tr>
                    <tr><td>Modell</td><td>@d.Model · @d.Timestamp.ToLocalTime().ToString("g")</td></tr>
                </tbody>
            </MudSimpleTable>
        }
        @if (_file.AiSuggestion is { } s)
        {
            <MudText Typo="Typo.h6">Tag-Vorschlag</MudText>
            <MudSimpleTable Dense="true">
                <tbody>
                    <tr><td>Künstler</td><td>@s.Artist (@string.Join(" | ", s.Artists))</td></tr>
                    <tr><td>Titel</td><td>@s.Title</td></tr>
                    <tr><td>Album</td><td>@s.Album</td></tr>
                    <tr><td>Sicherheit</td><td>@s.Confidence.ToString("P0")</td></tr>
                    <tr><td>Hinweis</td><td>@s.Notes</td></tr>
                    <tr><td>Verwendet</td><td>@(_file.CleanupSource == "ai" ? "ja, für die Suche" : "nein")</td></tr>
                </tbody>
            </MudSimpleTable>
        }
    </MudTabPanel>

    <MudTabPanel Text="Datei">
        <MudSimpleTable Dense="true">
            <tbody>
                <tr><td>Codec</td><td>@_file.Codec</td></tr>
                <tr><td>Bitrate</td><td>@_file.BitrateKbps kbps</td></tr>
                <tr><td>Dauer</td><td>@FormatLength(_file.DurationSeconds)</td></tr>
                <tr><td>Größe</td><td>@((_file.FileSize / 1024.0 / 1024.0).ToString("0.0")) MB</td></tr>
                <tr><td>Eingang</td><td class="mono">@_file.RelativePath</td></tr>
                <tr><td>Bibliothek</td><td class="mono">@_file.TargetPath</td></tr>
                <tr><td>Papierkorb</td><td class="mono">@_file.TrashPath</td></tr>
            </tbody>
        </MudSimpleTable>
        @if (_file.Error != null)
        {
            <MudExpansionPanels Class="mt-4">
                <MudExpansionPanel Text="Fehlerdetails">
                    <pre class="mono" style="white-space:pre-wrap">@_file.Error</pre>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </MudTabPanel>

    <MudTabPanel Text="Verlauf" BadgeData="_events.Count">
        <MudTimeline TimelinePosition="TimelinePosition.Start" TimelineAlign="TimelineAlign.Start">
            @foreach (var e in _events)
            {
                <MudTimelineItem Size="Size.Small" Color="@(e.Level switch { EventLevel.Error => Color.Error, EventLevel.Warning => Color.Warning, _ => Color.Default })">
                    <MudText Typo="Typo.caption">@e.Timestamp.ToLocalTime().ToString("g")</MudText>
                    <MudText Typo="Typo.body2">@e.Message</MudText>
                </MudTimelineItem>
            }
        </MudTimeline>
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter] public int Id { get; set; }

    private TrackFile? _file;
    private TrackFile? _preview;
    private string? _previewLabel;

    private sealed record CandidateRow(ReleaseCandidate? MusicBrainz, ExternalMatch? External);

    /// <summary>MusicBrainz candidates first (by points), then Spotify/Deezer matches (by agreement).</summary>
    private List<CandidateRow> CandidateRows => _file == null ? [] :
        _file.Candidates.Select(c => new CandidateRow(c, null))
            .Concat(_file.ExternalMatches.OrderByDescending(m => m.FromTagLink).ThenByDescending(m => m.Score).Select(m => new CandidateRow(null, m)))
            .ToList();
    private List<FileEvent> _events = [];
    private readonly HashSet<string> _expanded = [];
    private int _tab;

    private bool IsDuplicate => _file?.StatusReason?.StartsWith("Zieldatei existiert") == true;
    private bool IsOpen => _file?.Status is FileStatus.NeedsReview or FileStatus.NotInMusicBrainz or FileStatus.Error;
    private bool CanRetry => _file?.Status is FileStatus.NeedsReview or FileStatus.NotInMusicBrainz or FileStatus.Error;

    private static string FormatLength(double? seconds) =>
        seconds is { } s ? TimeSpan.FromSeconds(s).ToString(s >= 3600 ? @"h\:mm\:ss" : @"m\:ss") : "–";

    protected override async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _file = await db.Files.AsNoTracking().FirstOrDefaultAsync(f => f.Id == Id);
        _events = await db.Events.AsNoTracking().Where(e => e.TrackFileId == Id).OrderByDescending(e => e.Id).ToListAsync();
    }

    /// <summary>All categories with achieved and maximum points, including categories with 0 points.</summary>
    private static IEnumerable<(string Name, double Value, double? Max)> BreakdownRows(ReleaseCandidate c) =>
        c.BreakdownMax.Keys.Union(c.Breakdown.Keys)
            .Select(k => (k, c.Breakdown.GetValueOrDefault(k), c.BreakdownMax.TryGetValue(k, out var m) ? m : (double?)null))
            .Where(r => r.Item2 != 0 || r.Item3 is > 0)
            .OrderByDescending(r => (r.Item3 ?? 0) - r.Item2);

    private void ToggleBreakdown(string key)
    {
        if (!_expanded.Remove(key)) _expanded.Add(key);
    }

    private async Task Preview(ReleaseCandidate c)
    {
        try
        {
            _preview = await Review.PreviewCandidateAsync(Id, c.Key);
            _preview.SelectedCandidateKey = c.Key;
            _previewLabel = $"MusicBrainz: {c.Release.Title} ({c.Release.Date} · {c.Release.Country})";
            _tab = 1;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Vorschau fehlgeschlagen: {ex.Message}", Severity.Error);
        }
    }

    private async Task PreviewExternal(ExternalMatch m)
    {
        try
        {
            _preview = await Review.PreviewExternalAsync(Id, m.Key);
            _previewLabel = $"{MatchingPipeline.SourceName(m.Source)}: {m.Album} ({m.ReleaseDate})";
            _tab = 1;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Vorschau fehlgeschlagen: {ex.Message}", Severity.Error);
        }
    }

    private async Task ApplyExternal(ExternalMatch m)
    {
        try
        {
            await Review.ApplyExternalAsync([Id], m.Key);
            Snackbar.Add($"Tags aus {MatchingPipeline.SourceName(m.Source)} übernommen – Datei wird geschrieben.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
        }
    }

    private async Task Choose(ReleaseCandidate c)
    {
        try
        {
            await Review.ChooseCandidateAsync(Id, c.Key);
            Snackbar.Add("Release übernommen – Datei wird geschrieben.", Severity.Success);
            _preview = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
        }
    }

    private async Task Approve()
    {
        await Review.ApproveAsync(Id);
        Snackbar.Add("Bestätigt – Datei wird geschrieben.", Severity.Success);
    }

    private async Task SearchRelease()
    {
        var t = _file!.CleanedTags;
        var query = string.Join(" ", new[] { t?.Album ?? t?.Title, t?.AlbumArtist ?? t?.Artist }.Where(x => !string.IsNullOrWhiteSpace(x)));
        var parameters = new DialogParameters<ReleaseSearchDialog> { { x => x.FileIds, [Id] }, { x => x.Query, query } };
        await Dialogs.ShowAsync<ReleaseSearchDialog>("Release suchen", parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }

    private async Task Retry()
    {
        await Review.RetryAsync(Id);
        Snackbar.Add("Wird erneut verarbeitet.", Severity.Info);
    }

    private async Task Discard()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Verwerfen", "Datei in den Papierkorb verschieben, ohne sie einzusortieren?",
            yesText: "Verwerfen", cancelText: "Abbrechen");
        if (ok == true) await Review.DiscardAsync(Id);
    }
}
