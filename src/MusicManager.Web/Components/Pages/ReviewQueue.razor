@page "/pruefung"
@inherits LivePage
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ReviewService Review
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Prüfwarteschlange – Music Manager</PageTitle>

<PageHeader Title="Prüfwarteschlange" />

<StatusFilter Statuses="ReviewService.OpenStatuses" Selected="_statuses" SelectedChanged="SetStatuses" />

<ListLayout>
    <Wide>
        <MudDataGrid T="TrackFile" Items="Visible" Dense="true" Hover="true" MultiSelection="true" @bind-SelectedItems="_selected"
                     Groupable="true" GroupExpanded="true" RowsPerPage="100">
            <ToolBarContent>@Actions</ToolBarContent>
            <Columns>
                <SelectColumn T="TrackFile" />
                <PropertyColumn Property="x => x.Group!.RelativeFolder" Title="Gruppe" Grouping="true" Hidden="true">
                    <GroupTemplate>
                        <MudText Typo="Typo.subtitle2">@(string.IsNullOrEmpty(context.Grouping.Key?.ToString()) ? "Eingang (lose Dateien)" : context.Grouping.Key) (@context.Grouping.Count())</MudText>
                    </GroupTemplate>
                </PropertyColumn>
                <TemplateColumn Title="Original" SortBy="x => x.RelativePath">
                    <CellTemplate>
                        <TrackSummary File="context.Item" Variant="TrackSummary.SummaryVariant.Original" Href="@($"datei/{context.Item.Id}")" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Status" Title="Status">
                    <CellTemplate><StatusChip Status="context.Item.Status" /></CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.StatusReason" Title="Grund" />
                <TemplateColumn Title="Bester Kandidat">
                    <CellTemplate>@BestCandidate(context.Item)</CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText>Nichts zu prüfen. 🎉</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </Wide>
    <Narrow>
        <CardList Items="Visible" GroupBy="f => f.Group?.RelativeFolder" PageSize="50">
            <Toolbar>
                <div class="d-flex align-center flex-wrap" style="gap:4px 12px">
                    <MudCheckBox T="bool" Value="@(_selected.Count > 0 && _selected.Count == Visible.Count())" ValueChanged="SelectAll" Dense="true"
                                 Label="@(_selected.Count > 0 ? $"{_selected.Count} ausgewählt" : "Alle auswählen")" />
                </div>
                @Actions
            </Toolbar>
            <GroupHeader>@(string.IsNullOrEmpty(context.Key) ? "Eingang (lose Dateien)" : context.Key) (@context.Count)</GroupHeader>
            <ItemTemplate>
                <FileCard File="context" Selectable="true" Selected="_selected.Contains(context)" SelectedChanged="on => Select(context, on)">
                    @if (HasCandidate(context))
                    {
                        <div class="file-card-candidate">
                            <div class="file-card-label mb-1">Bester Kandidat</div>
                            @BestCandidate(context)
                        </div>
                    }
                </FileCard>
            </ItemTemplate>
            <NoItems>Nichts zu prüfen. 🎉</NoItems>
        </CardList>
    </Narrow>
</ListLayout>

@code {
    private List<TrackFile> _files = [];
    private HashSet<TrackFile> _selected = [];

    /// <summary>Batch actions; in the table toolbar or above the cards.</summary>
    private RenderFragment Actions => @<text>
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2" Class="py-2" Style="width:100%">
            @foreach (var source in PerfectSources)
            {
                var count = PerfectCount(source);
                <MudTooltip Text="@($"Alle Dateien ohne jeden MusicBrainz-Fund, die bei {MatchingPipeline.SourceName(source)} einen Treffer mit 100 % Übereinstimmung haben, mit dessen Tags einsortieren")">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.DoneAll"
                               Disabled="_busy || count == 0" OnClick="() => ApplyPerfect(source)" Style="white-space:nowrap">
                        @MatchingPipeline.SourceName(source) 100 % (@count)
                    </MudButton>
                </MudTooltip>
            }
            <MudSpacer />
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                <MudButton StartIcon="@Icons.Material.Filled.Search" Disabled="_selected.Count == 0" OnClick="SearchRelease">Release zuweisen</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.TravelExplore" Disabled="!_selected.Any(f => f.ExternalMatches.Count > 0)" OnClick="ApplyExternal">Spotify/Deezer übernehmen</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Edit" Disabled="_selected.Count == 0" OnClick="ManualTag">Manuell taggen</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Replay" Disabled="_selected.Count == 0" OnClick="Retry">Erneut verarbeiten</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" Disabled="_selected.Count == 0" OnClick="Discard">Verwerfen</MudButton>
            </MudButtonGroup>
        </MudStack>
    </text>;

    /// <summary>What the file would most likely become: best MusicBrainz candidate, else best external match or AI guess.</summary>
    private RenderFragment BestCandidate(TrackFile file) => @<text>
        @if (file.Candidates.FirstOrDefault() is { } best)
        {
            <SongCard Song="SongInfo.From(best)" />
            <MudText Typo="Typo.caption">MusicBrainz · @best.Score.ToString("0.#")@(best.MaxScore > 0 ? $" / {best.MaxScore:0.#}" : "") Punkte · @file.Candidates.Count Kandidaten</MudText>
        }
        else if (file.ExternalMatches.OrderByDescending(m => m.Score).FirstOrDefault() is { } ext)
        {
            <SongCard Song="SongInfo.From(ext)" />
            <MudText Typo="Typo.caption">@MatchingPipeline.SourceName(ext.Source) · @(ext.FromTagLink ? "Link aus den Tags" : $"{ext.Score:P0} Übereinstimmung") · @file.ExternalMatches.Count Treffer</MudText>
        }
        else if (file.AiSuggestion is { } s)
        {
            <MudText Typo="Typo.body2"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" /> @s.Artist – @s.Title</MudText>
        }
    </text>;

    private static bool HasCandidate(TrackFile f) => f.Candidates.Count > 0 || f.ExternalMatches.Count > 0 || f.AiSuggestion != null;

    private void Select(TrackFile file, bool on)
    {
        if (on) _selected.Add(file);
        else _selected.Remove(file);
    }

    private void SelectAll(bool on) => _selected = on ? Visible.ToHashSet() : [];

    /// <summary>Preselected statuses, e.g. from a dashboard tile: ?status=NeedsReview</summary>
    [SupplyParameterFromQuery] public string? Status { get; set; }

    private HashSet<FileStatus> _statuses = [];

    private IEnumerable<TrackFile> Visible => _statuses.Count == 0 ? _files : _files.Where(f => _statuses.Contains(f.Status));

    protected override void OnParametersSet() => _statuses = StatusFilter.Parse(Status);

    private void SetStatuses(IReadOnlyCollection<FileStatus> statuses)
    {
        _statuses = statuses.ToHashSet();
        _selected.RemoveWhere(f => _statuses.Count > 0 && !_statuses.Contains(f.Status));
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("status", _statuses.Count == 0 ? null : StatusFilter.Format(_statuses)), replace: true);
    }

    protected override async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _files = await db.Files.AsNoTracking().Include(f => f.Group)
            .Where(f => ReviewService.OpenStatuses.Contains(f.Status))
            .OrderBy(f => f.Group!.RelativeFolder).ThenBy(f => f.RelativePath)
            .ToListAsync();
        var ids = _files.Select(f => f.Id).ToHashSet();
        _selected = _files.Where(f => _selected.Any(s => s.Id == f.Id)).ToHashSet();
    }

    private static string Describe(TagSet? t) =>
        t == null ? "" : string.Join(" · ", new[] { t.Artist, t.Title, t.Album }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private List<int> SelectedIds => _selected.Select(f => f.Id).ToList();

    private async Task SearchRelease()
    {
        var first = _selected.First();
        var t = first.CleanedTags;
        var query = string.Join(" ", new[] { t?.Album ?? t?.Title, t?.AlbumArtist ?? t?.Artist }.Where(x => !string.IsNullOrWhiteSpace(x)));
        var parameters = new DialogParameters<ReleaseSearchDialog>
        {
            { x => x.FileIds, SelectedIds },
            { x => x.Query, query },
        };
        var dialog = await Dialogs.ShowAsync<ReleaseSearchDialog>("Release suchen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) _selected.Clear();
    }

    private async Task ApplyExternal()
    {
        var ids = _selected.Where(f => f.ExternalMatches.Count > 0).Select(f => f.Id).ToList();
        var problems = await Review.ApplyExternalAsync(ids);
        foreach (var p in problems) Snackbar.Add(p, Severity.Warning);
        Snackbar.Add($"{ids.Count - problems.Count} Datei(en) mit dem besten Spotify/Deezer-Treffer getaggt – werden geschrieben.", Severity.Success);
        _selected.Clear();
    }

    private static readonly string[] PerfectSources = ["deezer", "spotify"];
    private bool _busy;

    private int PerfectCount(string source) => _files.Count(f => ReviewService.PerfectMatch(f, source) != null);

    private async Task ApplyPerfect(string source)
    {
        var name = MatchingPipeline.SourceName(source);
        var ok = await Dialogs.ShowMessageBoxAsync($"100-%-Treffer von {name} übernehmen",
            $"{PerfectCount(source)} Datei(en) ohne MusicBrainz-Fund mit den Tags und dem Cover ihres 100-%-Treffers von {name} einsortieren?",
            yesText: "Übernehmen", cancelText: "Abbrechen");
        if (ok != true) return;

        _busy = true;
        try
        {
            var (applied, problems) = await Review.ApplyPerfectExternalAsync(source);
            foreach (var p in problems) Snackbar.Add(p, Severity.Warning);
            Snackbar.Add($"{applied} Datei(en) mit dem 100-%-Treffer von {name} getaggt – werden geschrieben.", Severity.Success);
            _selected.Clear();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ManualTag() => Nav.NavigateTo($"manuell?ids={string.Join(",", SelectedIds)}");

    private async Task Retry()
    {
        foreach (var id in SelectedIds) await Review.RetryAsync(id);
        Snackbar.Add($"{_selected.Count} Datei(en) werden erneut verarbeitet.", Severity.Info);
        _selected.Clear();
    }

    private async Task Discard()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Verwerfen",
            $"{_selected.Count} Datei(en) in den Papierkorb verschieben, ohne sie einzusortieren?", yesText: "Verwerfen", cancelText: "Abbrechen");
        if (ok != true) return;
        foreach (var id in SelectedIds) await Review.DiscardAsync(id);
        _selected.Clear();
    }
}
