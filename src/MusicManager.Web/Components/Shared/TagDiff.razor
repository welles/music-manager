@using MusicManager.Core.Services
@* Before/after view: tag fields in the original file vs. the fields that are written. *@

@if (Preview != null)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="OnClearPreview">
        Vorschau für Kandidat „@Preview.SelectedCandidate?.Release.Title“ (noch nicht übernommen)
    </MudAlert>
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@Count(Change.Added) neu</MudChip>
    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@Count(Change.Changed) geändert</MudChip>
    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">@Count(Change.Removed) entfernt</MudChip>
    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@Count(Change.Unchanged) unverändert</MudChip>
    <MudSpacer />
    <MudSwitch @bind-Value="_hideUnchanged" Color="Color.Primary" Label="Unveränderte ausblenden" />
</MudStack>

@if (File.OriginalFields.Count == 0)
{
    <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-2">Die Original-Felder wurden für diese Datei nicht erfasst (vor dem Update verarbeitet).</MudAlert>
}

@if (FinalTags == null)
{
    <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-2">Noch keine Tags zum Schreiben – Kandidat wählen, Vorschau öffnen oder manuell taggen.</MudAlert>
}

<MudSimpleTable Dense="true" Hover="true" Bordered="true">
    <thead>
        <tr><th>Feld</th><th>Vorher (Datei)</th><th>Nachher (wird geschrieben)</th><th>Änderung</th></tr>
    </thead>
    <tbody>
        @foreach (var row in Rows.Where(r => !_hideUnchanged || r.Change != Change.Unchanged))
        {
            <tr>
                <td class="mono">@row.Name</td>
                <td><TagValues Field="row.Before" Removed="row.Change == Change.Removed" /></td>
                <td>
                    @if (row.Change == Change.Removed)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.DeleteOutline">wird entfernt</MudChip>
                    }
                    else
                    {
                        <TagValues Field="row.After" />
                    }
                </td>
                <td>
                    @switch (row.Change)
                    {
                        case Change.Added:
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">neu</MudChip>
                            break;
                        case Change.Changed:
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">geändert</MudChip>
                            break;
                        case Change.Removed:
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">entfernt</MudChip>
                            break;
                        default:
                            <MudText Typo="Typo.caption" Style="opacity:.6">unverändert</MudText>
                            break;
                    }
                </td>
            </tr>
        }
        <tr>
            <td>Zielpfad</td>
            <td></td>
            <td class="mono" colspan="2">@((Preview ?? File).TargetPath)</td>
        </tr>
    </tbody>
</MudSimpleTable>

@if (File.CleanedTags is { } c)
{
    <MudExpansionPanels Class="mt-4">
        <MudExpansionPanel Text="@($"Für die Suche bereinigt ({(File.CleanupSource == "ai" ? "KI" : "Regeln")})")">
            <MudSimpleTable Dense="true">
                <tbody>
                    <tr><td>Titel</td><td>@c.Title</td></tr>
                    <tr><td>Künstler</td><td>@c.Artist</td></tr>
                    <tr><td>Künstler (einzeln)</td><td><TagValues Field="@(c.Artists.Count > 0 ? new TagField("", c.Artists) : null)" /></td></tr>
                    <tr><td>Album</td><td>@c.Album</td></tr>
                    <tr><td>Album-Künstler</td><td>@c.AlbumArtist</td></tr>
                    <tr><td>Track</td><td>@c.TrackNumber</td></tr>
                </tbody>
            </MudSimpleTable>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@code {
    [Parameter, EditorRequired] public TrackFile File { get; set; } = null!;
    [Parameter] public TrackFile? Preview { get; set; }
    [Parameter] public EventCallback OnClearPreview { get; set; }

    private bool _hideUnchanged;

    private enum Change { Added, Changed, Removed, Unchanged }

    private sealed record Row(string Name, TagField? Before, TagField? After, Change Change);

    private TagSet? FinalTags => (Preview ?? File).FinalTags;

    private List<Row> Rows
    {
        get
        {
            var before = File.OriginalFields.Where(f => !f.Name.StartsWith('_')).ToDictionary(f => f.Name, StringComparer.OrdinalIgnoreCase);
            var after = FinalTags == null
                ? new Dictionary<string, TagField>(StringComparer.OrdinalIgnoreCase)
                : TagFields.ForFinalTags(FinalTags, CoverDescription, MatchingPipeline.SourceFor(Preview ?? File))
                    .ToDictionary(f => f.Name, StringComparer.OrdinalIgnoreCase);

            return before.Keys.Union(after.Keys, StringComparer.OrdinalIgnoreCase)
                .Select(name =>
                {
                    before.TryGetValue(name, out var b);
                    after.TryGetValue(name, out var a);
                    var change = (b, a) switch
                    {
                        (null, not null) => Change.Added,
                        (not null, null) => FinalTags == null ? Change.Unchanged : Change.Removed,
                        (not null, not null) when b.Values.SequenceEqual(a.Values) => Change.Unchanged,
                        _ => Change.Changed,
                    };
                    return new Row(a?.Name ?? b!.Name, b, a, change);
                })
                .OrderBy(r => TagFields.SortKey(r.Name)).ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private string CoverDescription => File.CoverSource != null ? $"Front-Cover ({File.CoverSource})" : "Front-Cover (Quelle wird beim Schreiben ermittelt)";

    private int Count(Change change) => FinalTags == null ? 0 : Rows.Count(r => r.Change == change);
}
