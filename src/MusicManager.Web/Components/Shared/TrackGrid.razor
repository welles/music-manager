@inject PlayerService Player
@inject NavigationManager Nav
@* Track table of the library: search, problem filters, multi-selection, playback. *@

<MudDataGrid T="LibraryTrack" Items="Filtered" Class="track-grid" Dense="true" Hover="true" MultiSelection="true" @bind-SelectedItems="_selected"
             RowsPerPage="50" SortMode="SortMode.Multiple">
    <ToolBarContent>
        <MudStack Spacing="1" Style="width:100%">
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudTextField @bind-Value="_search" Placeholder="Titel, Künstler, Album suchen" Adornment="Adornment.Start" Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="mt-0" Style="max-width:360px" />
                <MudSelect T="TrackSort" @bind-Value="_sort" Label="Sortierung" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-0" Style="max-width:180px">
                    @foreach (var (value, label) in SortLabels)
                    {
                        <MudSelectItem T="TrackSort" Value="value">@label</MudSelectItem>
                    }
                </MudSelect>
                <MudSpacer />
                <MudText Typo="Typo.body2">@Filtered.Count() Titel@(_selected.Count > 0 ? $" · {_selected.Count} ausgewählt" : "")</MudText>
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                    <MudButton StartIcon="@Icons.Material.Filled.AutoFixHigh" Disabled="_selected.Count == 0" OnClick="Retag">Neu taggen</MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Edit" Disabled="_selected.Count == 0" OnClick="Edit">Bearbeiten</MudButton>
                </MudButtonGroup>
            </MudStack>
            <MudChipSet T="LibraryProblem" @bind-SelectedValues="_problemFilter" SelectionMode="SelectionMode.MultiSelection" CheckMark="true" Size="Size.Small">
                @foreach (var p in Enum.GetValues<LibraryProblem>())
                {
                    <MudChip T="LibraryProblem" Value="p" Text="@($"{ProblemLabel(p)} ({Count(p)})")" Variant="Variant.Outlined" />
                }
            </MudChipSet>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <SelectColumn T="LibraryTrack" />
        <TemplateColumn Title="" Sortable="false" Style="width:56px">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" OnClick="() => Player.Play(context.Item)" aria-label="Abspielen" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Titel" Sortable="false">
            <CellTemplate><SongCard Song="SongInfo.From(context.Item) with { Genres = [], Format = null }" /></CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Genre" SortBy="x => x.Genres.FirstOrDefault()">
            <CellTemplate>@string.Join(", ", context.Item.Genres)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Format" SortBy="x => x.BitrateKbps">
            <CellTemplate>@context.Item.Codec @(context.Item.BitrateKbps != null ? $"{context.Item.BitrateKbps} kbps" : "")</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Hinweise" Sortable="false">
            <CellTemplate>
                <div class="chip-wrap">
                    @foreach (var p in context.Item.Problems(RulesVersion))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(p == LibraryProblem.OldRules ? Color.Info : Color.Warning)">@ProblemLabel(p)</MudChip>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="LibraryTrack" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<LibraryTrack> Tracks { get; set; } = [];
    [Parameter, EditorRequired] public string RulesVersion { get; set; } = "";

    /// <summary>Preset problem filter (e.g. from a link).</summary>
    [Parameter] public LibraryProblem? InitialProblem { get; set; }

    [Parameter] public string? InitialSearch { get; set; }

    private HashSet<LibraryTrack> _selected = [];
    private IReadOnlyCollection<LibraryProblem> _problemFilter = [];
    private string? _search;

    protected override void OnInitialized()
    {
        if (InitialProblem is { } p) _problemFilter = [p];
        _search = InitialSearch;
    }

    /// <summary>Title, artist, album and year share one column (the SongCard), so their order is chosen here.</summary>
    private enum TrackSort { Given, Title, Artist, Album, YearNewest, YearOldest }

    private TrackSort _sort;

    private static readonly (TrackSort, string)[] SortLabels =
    [
        (TrackSort.Given, "Standard"), (TrackSort.Title, "Titel"), (TrackSort.Artist, "Künstler"), (TrackSort.Album, "Album"),
        (TrackSort.YearNewest, "Jahr (neu zuerst)"), (TrackSort.YearOldest, "Jahr (alt zuerst)"),
    ];

    private IEnumerable<LibraryTrack> Filtered => _sort switch
    {
        TrackSort.Title => Matching.OrderBy(t => t.Title ?? t.RelativePath, StringComparer.CurrentCultureIgnoreCase),
        TrackSort.Artist => Matching.OrderBy(t => t.ArtistNames.FirstOrDefault(), StringComparer.CurrentCultureIgnoreCase),
        TrackSort.Album => Matching.OrderBy(t => t.Album, StringComparer.CurrentCultureIgnoreCase).ThenBy(t => t.DiscNumber).ThenBy(t => t.TrackNumber),
        TrackSort.YearNewest => Matching.OrderByDescending(t => t.Year),
        TrackSort.YearOldest => Matching.OrderBy(t => t.Year ?? int.MaxValue),
        _ => Matching,
    };

    private IEnumerable<LibraryTrack> Matching => Tracks.Where(t =>
        (string.IsNullOrWhiteSpace(_search)
         || (t.Title?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
         || (t.Album?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
         || t.ArtistNames.Any(a => a.Contains(_search, StringComparison.OrdinalIgnoreCase))
         || t.Genres.Any(g => g.Equals(_search, StringComparison.OrdinalIgnoreCase)))
        && _problemFilter.All(p => t.Problems(RulesVersion).Contains(p)));

    private int Count(LibraryProblem p) => Tracks.Count(t => t.Problems(RulesVersion).Contains(p));

    public static string ProblemLabel(LibraryProblem p) => p switch
    {
        LibraryProblem.NotFromThisTool => "nicht von diesem Tool",
        LibraryProblem.OldRules => "alte Regeln",
        LibraryProblem.EditedOutside => "extern geändert",
        LibraryProblem.NoMusicBrainz => "ohne MusicBrainz",
        LibraryProblem.NoCover => "ohne Cover",
        LibraryProblem.NoGenre => "ohne Genre",
        LibraryProblem.WeakGenre => "Genres unsicher",
        LibraryProblem.LowBitrate => "Bitrate < 192",
        _ => p.ToString(),
    };

    public static string ArtistHref(string name) => $"bibliothek/kuenstler/{Uri.EscapeDataString(name)}";

    public static string AlbumHref(LibraryTrack t) =>
        $"bibliothek/album?artist={Uri.EscapeDataString(t.MainAlbumArtist ?? "")}&album={Uri.EscapeDataString(t.Album ?? "")}";

    private string Ids => string.Join(",", _selected.Select(t => t.Id));

    private void Retag() => Nav.NavigateTo($"bibliothek/neu-taggen?ids={Ids}");

    private void Edit() => Nav.NavigateTo($"bibliothek/bearbeiten?ids={Ids}");
}
