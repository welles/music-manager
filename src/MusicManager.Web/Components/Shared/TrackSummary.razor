@* A file of the inbox as a SongCard: cover, title, artist, labelled fields – the path only as a small secondary line.
   Variant "Original" shows the incoming file, "Result" what is (or will be) written. *@

@if (Variant == SummaryVariant.Result && Tags == null)
{
    @* While the file is on its way the reason is the current step (shown with the status), not a result. *@
    <MudText Typo="Typo.body2" Style="opacity:.75">@(StatusChip.IsActive(File.Status) ? "Noch kein Ergebnis" : File.StatusReason ?? "Noch kein Ergebnis")</MudText>
}
else
{
    <SongCard Song="Info" Dense="!Large" Href="@Href" ShowTitle="ShowTitle" CoverSizeOverride="@(Large ? 140 : null)" />
}

@code {
    public enum SummaryVariant { Auto, Original, Result }

    [Parameter, EditorRequired] public TrackFile File { get; set; } = null!;
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Large { get; set; }
    [Parameter] public bool ShowTitle { get; set; } = true;
    [Parameter] public SummaryVariant Variant { get; set; }

    private TagSet? Tags => Variant switch
    {
        SummaryVariant.Original => File.OriginalTags ?? File.CleanedTags,
        SummaryVariant.Result => File.FinalTags,
        _ => File.FinalTags ?? File.CleanedTags ?? File.OriginalTags,
    };

    public static string TitleOf(TrackFile f) => (f.FinalTags ?? f.CleanedTags ?? f.OriginalTags)?.Title ?? f.FileName;

    private string Title => Tags?.Title ?? File.FileName;

    private string? PathLine => Variant == SummaryVariant.Result ? File.TargetPath : File.RelativePath;

    private SongInfo Info => SongInfo.From(Tags) with
    {
        Title = Title,
        Duration = SongInfo.FormatLength(File.DurationSeconds),
        Format = Large ? SongInfo.FormatAudio(File.Codec, File.BitrateKbps) : null,
        Path = PathLine,
        CoverUrl = CoverUrl,
    };

    private string CoverUrl => $"api/files/{File.Id}/cover?v={File.UpdatedAt.UtcTicks}" + Variant switch
    {
        SummaryVariant.Original => "&which=original",
        SummaryVariant.Result => "&which=result",
        _ => "",
    };
}
